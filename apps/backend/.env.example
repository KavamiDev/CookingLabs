# Base locale lancée par docker compose (racine du dépôt)
DATABASE_URL="postgresql://cookinglabs:cookinglabs@localhost:5432/cookinglabs"
PORT=3001

# Clé qui signe les tokens de connexion (JWT). Générer une valeur longue et aléatoire :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-moi"
