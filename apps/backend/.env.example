# Base locale lancée par docker compose (racine du dépôt)
DATABASE_URL="postgresql://cookinglabs:cookinglabs@localhost:5432/cookinglabs"
PORT=3001

# Clé qui signe les tokens de connexion (JWT). Générer une valeur longue et aléatoire :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-moi"

# Nombre de proxys devant l'API (lecture de la vraie IP pour la limite de requêtes).
# 0 en local, 1 derrière Railway ou Fly.io.
TRUST_PROXY=0

# Adresse du site, utilisée dans les liens envoyés par e-mail (invitation)
FRONTEND_URL="http://localhost:3000"

# Envoi des e-mails avec Resend. Sans clé, le lien d'invitation est affiché dans la console
# (en développement uniquement : en production, l'envoi est refusé).
# RESEND_API_KEY="re_..."
# MAIL_FROM="CookingLabs <noreply@votre-domaine.fr>"

# Tentatives de connexion autorisées par minute et par IP (10 par défaut).
# Ne pas augmenter en production : seuls les tests end-to-end la relèvent.
# LOGIN_RATE_LIMIT=10
